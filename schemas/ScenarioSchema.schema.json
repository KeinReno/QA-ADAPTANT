{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED"
      ]
    },
    "originalTextSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "actor",
            "approvedAt",
            "contentSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "const": "ACCEPTANCE"
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "navigate"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/(?!\\/)"
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "fill"
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "containerRole": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "containerName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "exact": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "containerRole",
                      "containerName",
                      "role",
                      "name",
                      "exact"
                    ],
                    "additionalProperties": false
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "locator",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "click"
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "containerRole": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "containerName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "exact": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "containerRole",
                      "containerName",
                      "role",
                      "name",
                      "exact"
                    ],
                    "additionalProperties": false
                  },
                  "mutation": {
                    "type": "boolean"
                  },
                  "operationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "mutationName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "type",
                  "locator",
                  "mutation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "verify"
                  },
                  "operationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "type",
                  "operationId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "retry": {
            "type": "string",
            "const": "none"
          }
        },
        "required": [
          "id",
          "action",
          "timeoutMs",
          "retry"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "originalTextSha256",
    "approval",
    "mode",
    "operation",
    "inputs",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
